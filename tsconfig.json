{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "lib": ["ES2020", "DOM", "WebWorker", "DOM.Iterable"],
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@unplugin-pwa/core/info",
      "@unplugin-pwa/core/pwa-assets"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
