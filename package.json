{
  "name": "vite-pwa-react-router",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Zero-config PWA for React Router",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/react-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/react-router.git"
  },
  "bugs": "https://github.com/vite-pwa/react-router/issues",
  "keywords": [
    "react router",
    "react router preset",
    "workbox",
    "pwa",
    "vite",
    "unplugin-pwa"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./components": "./dist/components.mjs",
    "./config": "./dist/config.mjs",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./preset": "./dist/preset.mjs",
    "./create-pwa-context": "./dist/create-pwa-context.mjs",
    "./plugins/node/api": "./dist/plugins/node/api.mjs",
    "./plugins/runtime/sw": "./dist/plugins/runtime/sw.mjs",
    "./react-router-sw": {
      "types": "./react-router-sw.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "*.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "update:deps": "taze -I",
    "build": "tsdown",
    "test:typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@react-router/dev": "^8.1.0",
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@unplugin-pwa/core": "catalog:pwa",
    "@unplugin-pwa/inspector": "catalog:pwa",
    "@unplugin-pwa/vite": "catalog:pwa",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "@vite-pwa/workbox-swkit": "catalog:pwa",
    "@vite-pwa/workbox-window": "catalog:pwa"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@arethetypeswrong/core": "catalog:utils",
    "@react-router/dev": "catalog:rr8",
    "@types/node": "catalog:types",
    "@types/react": "catalog:react",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "@vitejs/devtools": "catalog:utils",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "https-localhost": "catalog:utils",
    "publint": "catalog:utils",
    "react-router": "catalog:rr8",
    "taze": "catalog:utils",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
